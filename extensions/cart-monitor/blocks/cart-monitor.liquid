{% comment %}
  CouponMaxx Cart Monitor + Smart Recovery
  Injected automatically on all storefront pages via theme app extension.
{% endcomment %}

<link rel="stylesheet" href="{{ 'smart-recovery.css' | asset_url }}">

<script
  src="{{ 'cart-monitor.js' | asset_url }}"
  data-shop="{{ shop.permanent_domain }}"
  data-ingest-url="{{ block.settings.app_url }}/api/cart/ingest"
  data-ping-url="{{ block.settings.app_url }}/api/session/ping"
  defer
></script>

<script
  src="{{ 'smart-recovery.js' | asset_url }}"
  data-shop="{{ shop.permanent_domain }}"
  data-recovery-url="{{ block.settings.app_url }}/api/couponmaxx/recovery/decide"
  defer
></script>

{% schema %}
{
  "name": "Cart Monitor",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL",
      "default": "https://couponmaxx.vercel.app",
      "info": "Do not change unless instructed by support."
    }
  ]
}
{% endschema %}
